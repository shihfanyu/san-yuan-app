<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- 宮位名稱 (右上角) -->
    <TextView android:id="@+id/tvPalaceLabel"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:textSize="9sp" android:textColor="#9CA3AF"
        android:paddingEnd="3dp" android:paddingTop="2dp"/>

    <!-- 火坑標記 (左上角) -->
    <TextView android:id="@+id/tvFireMark"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:text="🔥" android:textSize="10sp"
        android:paddingStart="2dp" android:paddingTop="2dp"
        android:visibility="gone"/>

    <!-- 中心容器 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center">

        <!-- 山星 + 向星 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center">
            <TextView android:id="@+id/tvMountStar"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:textSize="16sp" android:textStyle="bold" android:textColor="#DC2626"
                android:paddingStart="4dp"/>
            <TextView android:id="@+id/tvFacingStar"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textSize="16sp" android:textStyle="bold" android:textColor="#2563EB"
                android:paddingEnd="4dp"/>
        </LinearLayout>

        <!-- 元旦盤（大） -->
        <TextView android:id="@+id/tvPeriodStar"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="28sp" android:textStyle="bold" android:textColor="#111827"/>

    </LinearLayout>

    <!-- 方向 (底部居中) -->
    <TextView android:id="@+id/tvDirection"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:gravity="center"
        android:textSize="9sp" android:textColor="#9CA3AF"
        android:paddingBottom="2dp"/>

</FrameLayout>
