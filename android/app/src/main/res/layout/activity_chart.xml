<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8E7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 前運 -->
        <TextView android:id="@+id/labelPrev"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="前運" android:textStyle="bold" android:textSize="14sp"
            android:textColor="#6B7280" android:gravity="center"
            android:layout_marginBottom="4dp"/>
        <GridLayout android:id="@+id/chartPrev"
            android:layout_width="match_parent" android:layout_height="260dp"
            android:columnCount="3" android:rowCount="3"
            android:background="#E5E7EB"
            android:layout_marginBottom="16dp"/>

        <!-- 當運 -->
        <TextView android:id="@+id/labelCurrent"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="當運" android:textStyle="bold" android:textSize="16sp"
            android:textColor="#92400E" android:gravity="center"
            android:layout_marginBottom="4dp"/>
        <GridLayout android:id="@+id/chartCurrent"
            android:layout_width="match_parent" android:layout_height="300dp"
            android:columnCount="3" android:rowCount="3"
            android:background="#92400E"
            android:layout_marginBottom="16dp"/>

        <!-- 後運 -->
        <TextView android:id="@+id/labelNext"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="後運" android:textStyle="bold" android:textSize="14sp"
            android:textColor="#6B7280" android:gravity="center"
            android:layout_marginBottom="4dp"/>
        <GridLayout android:id="@+id/chartNext"
            android:layout_width="match_parent" android:layout_height="260dp"
            android:columnCount="3" android:rowCount="3"
            android:background="#E5E7EB"
            android:layout_marginBottom="12dp"/>

        <!-- 附加資訊 -->
        <TextView android:id="@+id/tvInfo"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#6B7280"
            android:background="#FFFBEB"
            android:padding="10dp"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>
